+</style>
+</head>
+<body>
+
+<header class="top">
+  <div class="wrap">
+    <h1>sp500-screener</h1>
+    <span class="strategy" id="strategyLabel">loading —</span>
+  </div>
+</header>
+
+<div class="wrap" id="app">
+  <div class="state-msg" id="stateMsg">Loading the latest run…</div>
+</div>
+
+<script>
+const $ = (sel, el = document) => el.querySelector(sel);
+const app = $('#app');
+
+const fmtUSD = (v) => v == null ? '—' :
+  '$' + v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
+const fmtPct = (v, digits = 2) => v == null ? '—' :
+  (v >= 0 ? '+' : '') + (v * 100).toFixed(digits) + '%';
+const pctClass = (v) => v == null ? '' : (v > 0 ? 'gain' : v < 0 ? 'loss' : '');
+const fmtNum = (v, digits = 2) => v == null ? '—' : Number(v).toFixed(digits);
+const fmtDate = (s) => {
+  if (!s) return '—';
+  const d = new Date(s + (s.length === 10 ? 'T00:00:00Z' : ''));
+  if (isNaN(d)) return s;
+  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
+};
+const el = (tag, attrs = {}, children = []) => {
+  const e = document.createElement(tag);
+  for (const [k, v] of Object.entries(attrs)) {
+    if (k === 'text') e.textContent = v;
+    else if (k === 'html') e.innerHTML = v;
+    else if (k === 'class') e.className = v;
+    else e.setAttribute(k, v);
+  }
+  (Array.isArray(children) ? children : [children]).forEach(c => c && e.appendChild(c));
+  return e;
+};
+
+/* ---- tiny dependency-free SVG line chart -------------------------------- */
+function lineChart(series, { width = 760, height = 220, pad = 6 } = {}) {
+  const all = series.flatMap(s => s.values.filter(v => v != null));
+  if (!all.length) return el('div', { text: 'not enough data yet' });
+  const min = Math.min(...all), max = Math.max(...all);
+  const span = (max - min) || 1;
+  const n = Math.max(...series.map(s => s.values.length));
+  const x = i => pad + (i / Math.max(1, n - 1)) * (width - 2 * pad);
+  const y = v => height - pad - ((v - min) / span) * (height - 2 * pad);
+
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
+  svg.setAttribute('class', 'chart');
+  svg.setAttribute('preserveAspectRatio', 'none');
+
+  series.forEach(s => {
+    const pts = s.values.map((v, i) => v == null ? null : `${x(i)},${y(v)}`).filter(Boolean);
+    if (pts.length < 2) return;
+    const path = document.createElementNS('http://www.w3.org/2000/svg', 'polyline');
+    path.setAttribute('points', pts.join(' '));
+    path.setAttribute('fill', 'none');
+    path.setAttribute('stroke', s.color);
+    path.setAttribute('stroke-width', s.width || 1.6);
+    path.setAttribute('stroke-linecap', 'round');
+    path.setAttribute('stroke-linejoin', 'round');
+    const len = pts.length * 40;
+    path.style.strokeDasharray = len;
+    path.style.strokeDashoffset = len;
+    path.style.transition = 'stroke-dashoffset 900ms ease-out';
+    svg.appendChild(path);
+    requestAnimationFrame(() => requestAnimationFrame(() => { path.style.strokeDashoffset = 0; }));
+  });
+  return svg;
+}
+
+/* ---- sections ------------------------------------------------------------- */
+function renderHero(d) {
+  const stats = d.stats || {};
+  const eq = (d.equity_curve || []).map(r => r.equity);
+  const bench = (d.equity_curve || []).map(r => r.benchmark_equity);
+
+  const hero = el('div', { class: 'hero' });
+  const left = el('div');
+  left.append(
+    el('div', { class: 'label', text: 'Portfolio equity' }),
+    el('div', { class: 'equity num', text: fmtUSD(d.portfolio ? d.portfolio.equity : null) }),
+    el('div', { class: `delta num ${pctClass(stats.total_return)}`, text: fmtPct(stats.total_return) + ' since inception' }),
+    el('div', {
+      class: 'bench',
+      text: stats.benchmark_return != null
+        ? `S&P 500 (SPY) over the same span: ${fmtPct(stats.benchmark_return)}`
+        : 'Benchmark not available yet'
+    }),
+  );
+  hero.appendChild(left);
+  if (eq.filter(v => v != null).length > 1) {
+    hero.appendChild(lineChart(
+      [{ values: eq, color: 'var(--accent)'.includes('var') ? '#d4a24c' : '#d4a24c', width: 1.8 }],
+      { width: 220, height: 64, pad: 3 }
+    ));
+    $('svg', hero).classList.add('spark');
+  }
+  return hero;
+}
+
+function renderStats(d) {
+  const s = d.stats || {};
+  const cells = [
+    ['Sharpe', fmtNum(s.sharpe, 2)],
+    ['CAGR', s.cagr != null ? fmtPct(s.cagr, 1) : '—'],
+    ['Max drawdown', s.max_drawdown != null ? fmtPct(s.max_drawdown, 1) : '—'],
+    ['Win rate', s.win_rate != null ? fmtPct(s.win_rate, 0) : '—'],
+    ['Closed trades', s.n_trades ?? '—'],
+    ['Avg hold (days)', fmtNum(s.avg_hold, 1)],
+    ['Days live', s.days_live ?? '—'],
+  ];
+  const wrap = el('div', { class: 'stats' });
+  cells.forEach(([k, v]) => wrap.appendChild(el('div', { class: 'stat' }, [
+    el('div', { class: 'k', text: k }),
+    el('div', { class: 'v', text: String(v) }),
+  ])));
+  return wrap;
+}
+
+function renderEquitySection(d) {
+  const rows = d.equity_curve || [];
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: 'Equity curve' }));
+  sec.appendChild(el('div', { class: 'sub', text: `Last ${rows.length} trading day${rows.length === 1 ? '' : 's'} of committed state.` }));
+  if (rows.length < 2) {
+    sec.classList.add('empty');
+    sec.appendChild(el('p', { text: 'Not enough history yet — check back after a few daily runs.' }));
+    return sec;
+  }
+  const chartWrap = el('div', { class: 'chart-wrap' });
+  chartWrap.appendChild(lineChart([
+    { values: rows.map(r => r.equity), color: '#d4a24c', width: 2 },
+    { values: rows.map(r => r.benchmark_equity), color: '#5b6470', width: 1.4 },
+  ], { width: 800, height: 240 }));
+  sec.appendChild(chartWrap);
+  const legend = el('div', { class: 'chart-legend' });
+  legend.appendChild(el('span', { html: '<span class="sw" style="background:#d4a24c"></span>Screener' }));
+  legend.appendChild(el('span', { html: '<span class="sw" style="background:#5b6470"></span>S&amp;P 500 (SPY)' }));
+  sec.appendChild(legend);
+  return sec;
+}
+
+function renderPositions(d) {
+  const p = d.portfolio || {};
+  const positions = p.positions || [];
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: 'Open positions' }));
+  sec.appendChild(el('div', {
+    class: 'sub',
+    text: `${p.n_positions ?? 0} of ${p.n_slots ?? '—'} ladder slots filled · cash ${fmtUSD(p.cash)}`
+  }));
+  if (!positions.length) {
+    sec.classList.add('empty');
+    sec.appendChild(el('p', { text: 'No open positions in the ladder right now.' }));
+  } else {
+    const table = el('table');
+    table.appendChild(el('thead', {}, el('tr', {}, [
+      el('th', { text: 'ticker' }), el('th', { text: 'sector' }),
+      el('th', { class: 'num', text: 'entry' }), el('th', { class: 'num', text: 'entry px' }),
+      el('th', { class: 'num', text: 'last px' }), el('th', { class: 'num', text: 'unrealised' }),
+      el('th', { class: 'num', text: 'held' }),
+    ])));
+    const tbody = el('tbody');
+    positions.forEach(row => {
+      const held = row.bars_held != null ? `${row.bars_held}/${d.strategy ? d.strategy.hold_days : '?'}d` : '—';
+      tbody.appendChild(el('tr', {}, [
+        el('td', {}, el('span', { class: 'ticker-badge', text: row.ticker })),
+        el('td', { class: 'name-cell', text: row.sector || '—' }),
+        el('td', { class: 'num', text: fmtDate(row.entry_date) }),
+        el('td', { class: 'num', text: fmtUSD(row.entry_price) }),
+        el('td', { class: 'num', text: fmtUSD(row.last_price) }),
+        el('td', { class: `num ${pctClass(row.unrealised_pct)}`, text: fmtPct(row.unrealised_pct) }),
+        el('td', { class: 'num', text: held }),
+      ]));
+    });
+    table.appendChild(tbody);
+    sec.appendChild(el('div', { class: 'tbl-scroll' }, table));
+  }
+  const pending = p.pending_orders || [];
+  if (pending.length) {
+    const note = el('div', { class: 'sub', style: 'margin-top:1rem' });
+    note.innerHTML = `Queued for next open: ` +
+      pending.map(o => `<span class="ticker-badge">${o.ticker}</span> (${o.sector || 'sector n/a'})`).join(', ');
+    sec.appendChild(note);
+  }
+  return sec;
+}
+
+function renderSectors(d) {
+  const p = d.portfolio || {};
+  const counts = p.sector_counts || {};
+  const cap = d.strategy ? d.strategy.max_positions_per_sector : null;
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: 'Sector exposure' }));
+  const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);
+  if (!entries.length) {
+    sec.classList.add('empty');
+    sec.appendChild(el('p', { text: 'No positions to break down by sector yet.' }));
+    return sec;
+  }
+  const maxScale = Math.max(cap || 1, ...entries.map(e => e[1]));
+  entries.forEach(([name, count]) => {
+    const row = el('div', { class: 'sector-row' });
+    row.appendChild(el('div', { class: 'name', text: name }));
+    const track = el('div', { class: 'sector-track' });
+    track.appendChild(el('div', { class: 'sector-fill', style: `width:${(count / maxScale) * 100}%` }));
+    if (cap) {
+      track.appendChild(el('div', { class: 'sector-cap-mark', style: `left:${(cap / maxScale) * 100}%` }));
+    }
+    row.appendChild(track);
+    row.appendChild(el('div', { class: 'count', text: cap ? `${count} / ${cap}` : String(count) }));
+    sec.appendChild(row);
+  });
+  return sec;
+}
+
+function renderCandidates(d) {
+  const rows = d.top_candidates || [];
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: "Today's screen" }));
+  sec.appendChild(el('div', {
+    class: 'sub',
+    text: `Top ${rows.length} by composite score, as of ${fmtDate(d.meta ? d.meta.data_date : null)}.`
+  }));
+  if (!rows.length) {
+    sec.classList.add('empty');
+    sec.appendChild(el('p', { text: 'No screen has run yet.' }));
+    return sec;
+  }
+  const blockCols = Object.keys(rows[0]).filter(k => k.startsWith('block_'));
+  const table = el('table');
+  table.appendChild(el('thead', {}, el('tr', {}, [
+    el('th', { text: '#' }), el('th', { text: 'ticker' }), el('th', { text: 'sector' }),
+    el('th', { class: 'num', text: 'composite' }),
+    ...blockCols.map(c => el('th', { class: 'num', text: c.replace('block_', '') })),
+  ])));
+  const tbody = el('tbody');
+  rows.forEach(row => {
+    tbody.appendChild(el('tr', {}, [
+      el('td', { text: row.rank != null ? String(Math.round(row.rank)) : '—' }),
+      el('td', {}, el('span', { class: 'ticker-badge', text: row.ticker })),
+      el('td', { class: 'name-cell', text: row.sector || '—' }),
+      el('td', { class: 'num', text: fmtNum(row.composite, 2) }),
+      ...blockCols.map(c => el('td', { class: 'num', text: fmtNum(row[c], 2) })),
+    ]));
+  });
+  table.appendChild(tbody);
+  sec.appendChild(el('div', { class: 'tbl-scroll' }, table));
+  return sec;
+}
+
+function renderWeights(d) {
+  const weights = d.factor_weights || {};
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: 'Factor weights' }));
+  sec.appendChild(el('div', {
+    class: 'sub',
+    text: d.learning && d.learning.enabled
+      ? `Self-learning is ${d.learning.mode || 'on'}; these adjust monthly within bounds.`
+      : 'Set by hand in config.yml.'
+  }));
+  Object.entries(weights).forEach(([name, w]) => {
+    const row = el('div', { class: 'weight-row' });
+    row.appendChild(el('div', { text: name }));
+    const track = el('div', { class: 'weight-track' });
+    track.appendChild(el('div', { class: 'weight-fill', style: `width:${Math.min(100, w * 100 * 2)}%` }));
+    row.appendChild(track);
+    row.appendChild(el('div', { class: 'pct', text: (w * 100).toFixed(0) + '%' }));
+    sec.appendChild(row);
+  });
+  return sec;
+}
+
+function renderTrades(d) {
+  const rows = d.recent_trades || [];
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: 'Recent closed trades' }));
+  if (!rows.length) {
+    sec.classList.add('empty');
+    sec.appendChild(el('p', { text: 'No positions have closed yet — the first entries are still inside their holding period.' }));
+    return sec;
+  }
+  const table = el('table');
+  table.appendChild(el('thead', {}, el('tr', {}, [
+    el('th', { text: 'ticker' }), el('th', { text: 'sector' }),
+    el('th', { text: 'entry' }), el('th', { text: 'exit' }),
+    el('th', { class: 'num', text: 'return' }), el('th', { class: 'num', text: 'pnl' }),
+  ])));
+  const tbody = el('tbody');
+  rows.forEach(row => {
+    tbody.appendChild(el('tr', {}, [
+      el('td', {}, el('span', { class: 'ticker-badge', text: row.ticker })),
+      el('td', { class: 'name-cell', text: row.sector || '—' }),
+      el('td', { text: fmtDate(row.entry_date) }),
+      el('td', { text: fmtDate(row.exit_date) }),
+      el('td', { class: `num ${pctClass(row.return_pct)}`, text: fmtPct(row.return_pct) }),
+      el('td', { class: `num ${pctClass(row.pnl)}`, text: fmtUSD(row.pnl) }),
+    ]));
+  });
+  table.appendChild(tbody);
+  sec.appendChild(el('div', { class: 'tbl-scroll' }, table));
+  return sec;
+}
+
+function renderLearning(d) {
+  const rows = (d.learning && d.learning.recent_decisions) || [];
+  const sec = el('section');
+  sec.appendChild(el('h2', { text: 'Learning log' }));
+  if (!rows.length) {
+    sec.classList.add('empty');
+    sec.appendChild(el('p', { text: 'No monthly tuning run has happened yet — it starts once 40+ trades have closed.' }));
+    return sec;
+  }
+  const table = el('table');
+  table.appendChild(el('thead', {}, el('tr', {}, [
+    el('th', { text: 'date' }), el('th', { text: 'decision' }), el('th', { text: 'reason' }),
+  ])));
+  const tbody = el('tbody');
+  rows.forEach(row => {
+    tbody.appendChild(el('tr', {}, [
+      el('td', { text: fmtDate(row.run_date) }),
+      el('td', { class: 'name-cell', text: row.decision || '—' }),
+      el('td', { class: 'name-cell', text: row.reason || '' }),
+    ]));
+  });
+  table.appendChild(tbody);
+  sec.appendChild(el('div', { class: 'tbl-scroll' }, table));
+  return sec;
+}
+
+function renderFooter(d) {
+  const meta = d.meta || {};
+  return el('footer', {
+    html: `Last run ${meta.run_time || '—'} on data through ${fmtDate(meta.data_date)}. ` +
+          `Fundamentals as of ${fmtDate(meta.fundamentals_asof)}. ` +
+          `Universe ${meta.universe_size ?? '—'} names, ${meta.eligible_count ?? '—'} eligible. ` +
+          `Page generated ${d.generated_at || '—'}. ` +
+          `<a href="https://github.com/Vitoldinijs/sp500-screener" target="_blank" rel="noopener">source on GitHub</a>.`
+  });
+}
+
+async function main() {
+  let d;
+  try {
+    const res = await fetch('data/dashboard.json', { cache: 'no-store' });
+    if (!res.ok) throw new Error(`HTTP ${res.status}`);
+    d = await res.json();
+  } catch (err) {
+    $('#stateMsg').textContent = 'No data published yet — the first daily run will populate this page.';
+    return;
+  }
+
+  $('#strategyLabel').textContent =
+    `${(d.strategy && d.strategy.name) || 'strategy'} · ${(d.strategy && d.strategy.hold_days) || '?'}d hold`;
+
+  app.innerHTML = '';
+  app.appendChild(renderHero(d));
+  app.appendChild(renderStats(d));
+  app.appendChild(renderEquitySection(d));
+  app.appendChild(renderPositions(d));
+  app.appendChild(renderSectors(d));
+  app.appendChild(renderCandidates(d));
+  app.appendChild(renderWeights(d));
+  app.appendChild(renderTrades(d));
+  app.appendChild(renderLearning(d));
+  app.appendChild(renderFooter(d));
+}
+
+main();
+</script>
+</body>
+</html>
